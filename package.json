{
  "name": "react-ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  },
  "scripts": {
    "check:react-versions": "node scripts/check-react-versions.mjs",
    "seo:source": "node scripts/generate-sitemap-robots.mjs",
    "dev": "node scripts/generate-sitemap-robots.mjs && vite",
    "assets:optimize": "node scripts/optimize-backgrounds.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "build": "pnpm run check:react-versions && node scripts/generate-sitemap-robots.mjs && pnpm run assets:optimize && tsc -b && vite build && node scripts/generate-static-seo.mjs && pnpm run verify:dist",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "flag-icons": "^7.5.0",
    "framer-motion": "^13.2.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "jsmediatags": "^3.9.7",
    "katex": "^0.16.47",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.6",
    "baseline-browser-mapping": "^2.11.24",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
