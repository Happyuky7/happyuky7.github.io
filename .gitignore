# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime/editor caches
.eslintcache
.stylelintcache

node_modules
dist/
dist-ssr/
*.local

# This repo uses pnpm - pnpm-lock.yaml is the ONLY lockfile (commit it!)
package-lock.json
npm-shrinkwrap.json
yarn.lock
bun.lockb

# pnpm local state (the store/virtual dir must never be committed)
.pnpm-store/
.pnpm/
*.tgz

# TypeScript build info
*.tsbuildinfo

# Env files
.env
.env.*
!.env.example

# Vite cache
.vite

# Generic caches
.cache/
.parcel-cache/
.turbo/

# Coverage
coverage

# Hosting/platform folders
.vercel/
.netlify/
.firebase/

# Local experiments / scratch files
/test*.html
src/pages/hometes.tsx
src/**/* copy.tsx

# Legacy/experimental sections (keep in repo, but don't track changes)
src/components/skills-antiguo/
src/components/archos/
src/pages/ArchOS.tsx
src/components/terminalfun/FunTerminal.tsx

# Generated SEO sources (generated by scripts on dev/build)
public/sitemap.xml
public/robots.txt

# Separate repo (github.com/Happyuky7/links) cloned here for local work.
# Committing it as-is would create a broken gitlink; make it a submodule if
# you ever want it versioned from this repo.
/links/

# Google Search Console exports: raw CSV/ZIP dumps stay local.
# The write-up inside stays trackable - drop the '!' line to ignore it too.
/happyuky7.com-google search/*
!/happyuky7.com-google search/*.md

# Oversized media (keep local, don't commit)
public/assets/video/background4.mp4

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Sensitive files / keys
# .npmrc can hold registry auth tokens - keep project-wide pnpm settings in
# pnpm-workspace.yaml instead (pnpm 11 no longer reads the "pnpm" field in package.json).
.npmrc
.pnpmrc
*.pem
*.key

README1.md